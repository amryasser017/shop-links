# CHANGED: address of YOUR Flask API (used by the React app). Locally: http://127.0.0.1:5000
VITE_API_URL=http://127.0.0.1:5000

# Copy to .env for local dev (never commit .env). On Vercel set these in Project Settings > Environment Variables.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# optional, used to sign login tokens (defaults to ADMIN_PASSWORD)
ADMIN_SECRET=
# Upstash Redis (Vercel Marketplace > Upstash) - required in production so data persists
KV_REST_API_URL=
KV_REST_API_TOKEN=
